[Desktop Entry]
Type=Application
Name=OFS
GenericName=File sync
Comment=Local folder sync
Exec=ofs
Icon=ofs
Terminal=false
StartupWMClass=com.ofs.LocalSync
Categories=Utility;FileTools;
Keywords=sync;backup;folders;
Actions=NewWindow;

[Desktop Action NewWindow]
Name=New Window
Exec=ofs --new-window
Icon=ofs
